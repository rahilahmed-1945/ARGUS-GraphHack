# Copy to .env (or run `npm run env:init`, which generates the database secrets). Never commit .env.

# FalkorDB endpoint
ARGUS_FALKORDB_HOST=localhost
ARGUS_FALKORDB_PORT=6379

# Database identities (spec §3.4): admin = orchestrator (WORLD + TWIN); agent = MCP tool server (ACL-restricted)
ARGUS_ADMIN_PASSWORD=
ARGUS_AGENT_PASSWORD=

# Real LLM (live mode only). OpenRouter, tool calling, temperature 0.
OPENROUTER_API_KEY=
# A tool-calling model id on OpenRouter (spec TBD #19 — choose before live runs)
ARGUS_LLM_MODEL=
# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Socket.IO event server for the demo
ARGUS_PORT=4000
